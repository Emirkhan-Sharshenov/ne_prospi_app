<?xml version="1.0" encoding="utf-8"?>
<!-- Шаг 2: настройка будильника для выбранной остановки. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/destSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_location"
            app:tint="@color/danger" />

        <TextView
            android:id="@+id/destTitle"
            style="@style/Text.Headline"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2" />

        <Button
            android:id="@+id/saveBtn"
            style="@style/Button.Icon"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/save_place"
            app:icon="@drawable/ic_bookmark" />

        <Button
            android:id="@+id/clearDestBtn"
            style="@style/Button.Icon.Plain"
            android:contentDescription="@string/clear_dest"
            app:icon="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/destSubtitle"
        style="@style/Text.Body.Muted"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"
        android:textSize="15sp" />

    <!-- По расстоянию / По времени -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/segment_track"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/modeDist"
                style="@style/Button.Segment"
                android:text="@string/mode_dist_short"
                app:icon="@drawable/ic_ruler" />

            <Button
                android:id="@+id/modeTime"
                style="@style/Button.Segment"
                android:text="@string/mode_time_short"
                app:icon="@drawable/ic_schedule" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wakeLabel"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/wake_before_stop" />

        <TextView
            android:id="@+id/soundModeLink"
            style="@style/Text"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="4dp"
            android:fontFamily="@font/onest_bold"
            android:padding="4dp"
            android:textColor="@color/accent_text"
            android:textSize="14sp"
            app:drawableTint="@color/accent_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wakeOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Title"
            android:text="@string/backup_label" />

        <Button
            android:id="@+id/backupInfo"
            style="@style/Button.Icon.Plain"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/backup_info_title"
            app:icon="@drawable/ic_info"
            app:iconSize="20dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/backupOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <Button
        android:id="@+id/startBtn"
        style="@style/Button.Pill"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_gradient"
        android:elevation="6dp"
        android:text="@string/start_trip"
        android:textSize="18sp"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_alarm_on"
        app:iconSize="26dp" />

    <Button
        android:id="@+id/simBtn"
        style="@style/Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/simulate_short"
        app:icon="@drawable/ic_play_circle" />
</LinearLayout>
