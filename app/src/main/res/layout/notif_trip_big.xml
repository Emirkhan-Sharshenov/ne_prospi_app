<?xml version="1.0" encoding="utf-8"?>
<!-- Уведомление поездки, раскрытое (макет 4): куда едем, крупно сколько осталось, время, полоса, зона будильника. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@android:style/TextAppearance.Material.Notification.Info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:text="@string/notif_inbound"
        android:textAllCaps="true"
        android:textColor="#FF2F6FE4"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/notifTitle"
        style="@android:style/TextAppearance.Material.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notifDistance"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/notifUnit"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/notifEta"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FF9E6A00"
            android:textSize="16sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notifProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@drawable/notif_progress" />

    <TextView
        android:id="@+id/notifZone"
        style="@android:style/TextAppearance.Material.Notification.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:textColor="#FF9E6A00"
        android:textSize="13sp" />
</LinearLayout>
