<?xml version="1.0" encoding="utf-8"?>
<!-- Проверка надёжности (макет 7). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/backBtn"
            style="@style/Button.Icon"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Headline"
                android:text="@string/setup_title"
                android:textSize="22sp" />

            <TextView
                style="@style/Text.Label"
                android:text="@string/setup_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- итог: «Нужно исправить: 2» или «Всё готово» -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summaryCard"
                style="@style/TonalCard"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/warn_container"
                app:cardCornerRadius="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <FrameLayout
                        android:id="@+id/summaryIconBg"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circle"
                        android:backgroundTint="@color/amber">

                        <ImageView
                            android:id="@+id/summaryIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/navy" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/setupSummary"
                                style="@style/Text.Headline"
                                android:textColor="@color/on_warn_container"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/priorityBadge"
                                style="@style/StatusPill"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/pill"
                                android:backgroundTint="@color/warn"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:text="@string/high_priority"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/summaryText"
                            style="@style/Text.Body"
                            android:layout_marginTop="6dp"
                            android:text="@string/setup_intro"
                            android:textColor="@color/on_warn_container" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/checkList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TonalCard"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/Text.Title"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/oem_title"
                        app:drawableStartCompat="@drawable/ic_info"
                        app:drawableTint="@color/accent" />

                    <TextView
                        android:id="@+id/oemText"
                        style="@style/Text.Body.Muted"
                        android:layout_width="match_parent"
                        android:layout_marginTop="6dp" />

                    <Button
                        android:id="@+id/oemBtn"
                        style="@style/Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/open_app_settings"
                        app:icon="@drawable/ic_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/testAlarmBtn"
                style="@style/Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:text="@string/test_alarm"
                android:textColor="@color/on_accent_container"
                app:backgroundTint="@color/accent_container"
                app:icon="@drawable/ic_music"
                app:iconTint="@color/on_accent_container" />

            <TextView
                style="@style/Text.Body.Muted"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/setup_footer"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/setupDone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:background="@drawable/btn_gradient"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:foreground="@drawable/ripple_pill">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/onest_bold"
            android:text="@string/setup_done"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </FrameLayout>
</LinearLayout>
