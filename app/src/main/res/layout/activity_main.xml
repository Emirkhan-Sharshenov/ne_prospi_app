<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 1. Куда едем -->
            <LinearLayout style="@style/Card">

                <TextView style="@style/CardTitle" android:text="1. Куда едем" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Улица, станция, остановка…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted" />

                    <Button
                        android:id="@+id/searchBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Найти" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/destText"
                    style="@style/Muted"
                    android:layout_marginTop="10dp"
                    android:text="Или нажмите на карту, чтобы отметить остановку."
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/saveBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ Сохранить место"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/places"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 2. Когда будить -->
            <LinearLayout style="@style/Card">

                <TextView style="@style/CardTitle" android:text="2. Когда будить" />

                <RadioGroup
                    android:id="@+id/modeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/modeDist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="По расстоянию до остановки" />

                    <RadioButton
                        android:id="@+id/modeTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="За несколько минут до прибытия" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/seek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingVertical="12dp" />

                    <TextView
                        android:id="@+id/valueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:minWidth="72dp"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/Muted"
                    android:text="Сначала придёт мягкое уведомление, потом — громкий будильник поверх экрана блокировки." />
            </LinearLayout>

            <!-- 3. Поездка -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="3. Поездка" />

                    <TextView
                        android:id="@+id/phaseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="не начата"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatBox">
                        <TextView style="@style/StatLabel" android:text="До остановки" />
                        <TextView android:id="@+id/distText" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatBox">
                        <TextView style="@style/StatLabel" android:text="Прибытие через" />
                        <TextView android:id="@+id/etaText" style="@style/StatValue" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatBox">
                        <TextView style="@style/StatLabel" android:text="Скорость" />
                        <TextView android:id="@+id/speedText" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatBox">
                        <TextView style="@style/StatLabel" android:text="Точность GPS" />
                        <TextView android:id="@+id/accText" style="@style/StatValue" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/startBtn"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="▶  Начать поездку"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/simBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="🧪  Симуляция поездки (для проверки)" />

                <Button
                    android:id="@+id/stopBtn"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/danger"
                    android:text="■  Завершить поездку"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/Muted"
                    android:text="После старта можно заблокировать телефон и убрать в карман — приложение разбудит вас." />

                <Button
                    android:id="@+id/batteryBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋 Разрешить работу в фоне без ограничений" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
