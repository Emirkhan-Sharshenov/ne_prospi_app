<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_title"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/historyBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/history"
            android:text="🕘"
            android:textSize="20sp" />

        <Button
            android:id="@+id/settingsBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/settings"
            android:text="⚙️"
            android:textSize="20sp" />
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 1. Куда едем -->
            <LinearLayout style="@style/Card">

                <TextView style="@style/CardTitle" android:text="@string/card_where" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted" />

                    <Button
                        android:id="@+id/searchBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/search_btn" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/destText"
                    style="@style/Muted"
                    android:layout_marginTop="10dp"
                    android:text="@string/dest_hint"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/saveBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save_place"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/places"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 2. Когда будить -->
            <LinearLayout style="@style/Card">

                <TextView style="@style/CardTitle" android:text="@string/card_when" />

                <RadioGroup
                    android:id="@+id/modeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/modeDist"
                        style="@style/Radio"
                        android:text="@string/mode_dist" />

                    <RadioButton
                        android:id="@+id/modeTime"
                        style="@style/Radio"
                        android:text="@string/mode_time" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/seek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingVertical="12dp" />

                    <TextView android:id="@+id/valueText" style="@style/SliderValue" />
                </LinearLayout>

                <TextView
                    style="@style/Muted"
                    android:layout_marginTop="12dp"
                    android:text="@string/backup_title"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/backupSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingVertical="12dp" />

                    <TextView android:id="@+id/backupText" style="@style/SliderValue" />
                </LinearLayout>

                <TextView style="@style/Muted" android:text="@string/when_note" />
            </LinearLayout>

            <!-- 3. Поездка -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/card_trip" />

                    <TextView
                        android:id="@+id/phaseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/phase_idle"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatBox">
                        <TextView style="@style/StatLabel" android:text="@string/stat_distance" />
                        <TextView android:id="@+id/distText" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatBox">
                        <TextView style="@style/StatLabel" android:text="@string/stat_eta" />
                        <TextView android:id="@+id/etaText" style="@style/StatValue" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatBox">
                        <TextView style="@style/StatLabel" android:text="@string/stat_speed" />
                        <TextView android:id="@+id/speedText" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatBox">
                        <TextView style="@style/StatLabel" android:text="@string/stat_accuracy" />
                        <TextView android:id="@+id/accText" style="@style/StatValue" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tripStatus"
                    style="@style/Muted"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/startBtn"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="@string/start_trip"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/simBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/simulate_trip" />

                <Button
                    android:id="@+id/stopBtn"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/danger"
                    android:text="@string/stop_trip"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/shareBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/share_trip"
                    android:visibility="gone" />

                <TextView style="@style/Muted" android:text="@string/lock_note" />

                <Button
                    android:id="@+id/batteryBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_unrestricted" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
