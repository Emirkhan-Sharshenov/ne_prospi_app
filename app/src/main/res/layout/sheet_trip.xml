<?xml version="1.0" encoding="utf-8"?>
<!-- Шаг 3: поездка — большое расстояние, время, полоса прогресса, точность и скорость. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tripSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/phaseText"
            style="@style/StatusPill"
            android:background="@drawable/pill"
            android:ellipsize="end"
            android:maxLines="1"
            app:drawableStartCompat="@drawable/dot" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/soundPill"
            style="@style/StatusPill"
            android:layout_marginStart="8dp"
            android:background="@drawable/pill"
            android:backgroundTint="@color/surface_mid"
            android:textColor="@color/text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/distance_to_alarm" />

        <TextView
            style="@style/Text.Label"
            android:text="@string/estimated" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/distText"
            style="@style/Text.Display"
            android:text="—" />

        <TextView
            android:id="@+id/distUnit"
            style="@style/Text.Headline"
            android:layout_width="0dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/etaText"
            style="@style/StatusPill"
            android:background="@drawable/pill"
            android:backgroundTint="@color/warn_container"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textColor="@color/on_warn_container"
            android:textSize="22sp"
            app:drawableStartCompat="@drawable/ic_schedule"
            app:drawableTint="@color/on_warn_container" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/progressStart"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/progressPercent"
            style="@style/Text.Title"
            android:textColor="@color/accent_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/progressEnd"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/warn"
            android:textSize="14sp" />
    </LinearLayout>

    <com.nesprosi.app.main.TripProgressView
        android:id="@+id/tripProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <!-- точность и скорость -->
    <com.google.android.material.card.MaterialCardView
        style="@style/TonalCard"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp">

            <include
                android:id="@+id/statAccuracy"
                layout="@layout/item_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/statSpeed"
                layout="@layout/item_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tripStatus"
        style="@style/Text.Body.Muted"
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/shareBtn"
            style="@style/Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/share_short"
            android:textColor="@color/on_accent_container"
            app:backgroundTint="@color/accent_container"
            app:icon="@drawable/ic_share"
            app:iconTint="@color/on_accent_container" />

        <Button
            android:id="@+id/stopBtn"
            style="@style/Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/stop_short"
            android:textColor="@color/on_danger_container"
            app:backgroundTint="@color/danger_container"
            app:icon="@drawable/ic_stop_circle"
            app:iconTint="@color/on_danger_container" />
    </LinearLayout>
</LinearLayout>
